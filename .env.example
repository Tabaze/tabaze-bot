# --- Server ------------------------------------------------------------------
PORT=3000

# Active provider used when no explicit routing override is given.
# One of: openai | anthropic | gemini | local
LLM_PROVIDER=openai
ACTIVE_MODEL=gpt-4o-mini

# --- Routing (Strategy pattern) -------------------------------------------
# Optional: if omitted, PRIMARY_PROVIDER/PRIMARY_MODEL default to
# LLM_PROVIDER/ACTIVE_MODEL above. FALLBACK_PROVIDER and FALLBACK_MODEL
# must be set together, or not at all.
PRIMARY_PROVIDER=openai
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_PROVIDER=anthropic
FALLBACK_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Google Gemini -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Local / OpenAI-compatible (Ollama, vLLM, LM Studio, ...) ---------------
# Examples:
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3

# --- Retry policy -------------------------------------------------------------
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BASE_DELAY_MS=250
LLM_RETRY_MAX_DELAY_MS=8000

# --- Circuit breaker -----------------------------------------------------------
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_MS=30000
LLM_CIRCUIT_BREAKER_HALF_OPEN_MAX_ATTEMPTS=1

# --- Timeouts ------------------------------------------------------------------
LLM_DEFAULT_TIMEOUT_MS=60000

# --- Observability ---------------------------------------------------------------
LOG_LEVEL=info
