{
  "name": "multi-llm-abstraction-layer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade, zero-vendor-lock-in multi-LLM abstraction layer (OpenAI, Anthropic, Gemini, and OpenAI-compatible local inference servers).",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "gpt-tokenizer": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
